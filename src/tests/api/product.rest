@baseUrl = http://localhost:3000
@productsUrl = {{baseUrl}}/api/v2/products

### GET all products
GET {{productsUrl}}

### GET product by ID
GET {{productsUrl}}/ready_001

### GET product by referencename
GET {{productsUrl}}/Boat_Ready_L

### Create new product (example: ready)
POST {{productsUrl}}
Content-Type: application/json

{
  "type": "ready",
  "name": "Boat",
  "image": "boat.jpg",
  "price": 150,
  "stock_count": 10,
  "size": "L",
  "is_active": true,
  "referencename": "Boat_Ready_L"
}

### Update product by ID
PATCH {{productsUrl}}/6970b89d8410988ecef078c3
Content-Type: application/json

{
  "price": 160,
  "stock_count": 8
}

### Update product by referencename
PATCH {{productsUrl}}/Boat_Ready_L
Content-Type: application/json

{
  "price": 170,
  "stock_count": 2
}

### Delete product by ID
DELETE {{productsUrl}}/6970b89d8410988ecef078c3

### Delete product by referencename
DELETE {{productsUrl}}/Boat_Ready_L


# -----------------------------------------------------------------------------
# Ingredient products
# - type: "ingredient"
# - price: "+" price to add on top of base product
# - no image, no size
# - stock_count: random
# -----------------------------------------------------------------------------

### Create ingredient: Herbs - Jasmine (+20)
POST {{productsUrl}}
Content-Type: application/json

{
  "type": "ingredient",
  "name": "Jasmine",
  "price": 20,
  "stock_count": 37,
  "is_active": true,
